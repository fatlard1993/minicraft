{
  "schemaVersion": 1,
  "id": "minicraft-justfatlard",
  "version": "${version}",
  "name": "Minicraft",
  "description": "Build at full size, keep it as one block: a bench that shrinks what you make",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/minicraft"
  },
  "license": "MIT",
  "icon": "assets/minicraft-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.minicraft.Main"
    ]
  },
  "mixins": [
    "minicraft-justfatlard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "pandorical": ">=15.30.0"
  },
  "suggests": {
    "block-tip": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://github.com/sponsors/fatlard1993"
      }
    }
  }
}
